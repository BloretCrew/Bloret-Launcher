{
  "spec_version": "1.0.0",
  "manifest_names": ["plugin.json", "cwplugin.json"],
  "entry_candidates": {
    "python": ["main.py", "plugin.py"],
    "process": ["main.exe", "main"],
    "qml_page": ["main.qml", "ui/Page.qml", "ui/page.qml"]
  },
  "permissions": {
    "ui.nav": {"risk": "safe", "label": "添加导航页"},
    "ui.theme": {"risk": "safe", "label": "修改主题"},
    "ui.settings": {"risk": "safe", "label": "添加设置项"},
    "ui.toolbar": {"risk": "safe", "label": "扩展 Minecraft 小工具栏"},
    "launch.hooks": {"risk": "high", "label": "拦截或修改游戏启动"},
    "download.hooks": {"risk": "high", "label": "拦截下载或安装流程"},
    "agent.bloriko": {"risk": "high", "label": "扩展络可 Agent"},
    "agent.blrpe": {"risk": "high", "label": "扩展 BLRPE Copilot"},
    "config.read": {"risk": "safe", "label": "读取启动器配置"},
    "config.write": {"risk": "high", "label": "写入启动器配置"},
    "fs.datapath": {"risk": "high", "label": "访问数据目录文件"},
    "net.http": {"risk": "high", "label": "发起网络请求"},
    "process.exec": {"risk": "high", "label": "执行外部进程"},
    "web.routes": {"risk": "high", "label": "注册本地 Web 路由"}
  },
  "hooks": {
    "on_enable": null,
    "on_disable": null,
    "on_load": null,
    "on_unload": null,
    "app.ready": null,
    "app.quit": null,
    "launch.pre": "launch.hooks",
    "launch.jvm_args": "launch.hooks",
    "launch.env": "launch.hooks",
    "launch.post": "launch.hooks",
    "launch.exit": "launch.hooks",
    "download.start": "download.hooks",
    "download.progress": "download.hooks",
    "download.complete": "download.hooks",
    "download.error": "download.hooks",
    "download.post": "download.hooks",
    "account.login": null,
    "account.logout": null,
    "passport.sync": null,
    "theme.changed": "ui.theme",
    "ui.page.open": null,
    "agent.bloriko.message": "agent.bloriko",
    "agent.blrpe.message": "agent.blrpe",
    "toolbar.action": "ui.toolbar",
    "config.changed": null
  },
  "contributes": {
    "nav": "ui.nav",
    "theme": "ui.theme",
    "settings": "ui.settings",
    "toolbar": "ui.toolbar",
    "prompts.bloriko": "agent.bloriko",
    "prompts.blrpe": "agent.blrpe",
    "agent_tools.bloriko": "agent.bloriko",
    "agent_tools.blrpe": "agent.blrpe",
    "web_routes": "web.routes",
    "i18n": null
  }
}
